[Unit]
Description=BaicaiBlogs Spring Boot Backend
After=network.target mysql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt
# 生产数据库密码由服务器本地环境文件注入，不进入 Git
EnvironmentFile=/etc/baicai/backend.env
ExecStart=/usr/bin/java -jar /opt/my-blog-backend-1.0.0.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=baicai-backend

[Install]
WantedBy=multi-user.target
