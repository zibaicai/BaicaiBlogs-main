[Unit]
Description=BaicaiBlogs Public Site (Next.js)
After=network.target baicai-backend.service

[Service]
Type=simple
WorkingDirectory=/opt/baicai-public
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
Environment=API_INTERNAL=http://127.0.0.1:8080
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=baicai-public

[Install]
WantedBy=multi-user.target
