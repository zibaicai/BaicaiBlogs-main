# BaicaiBlogs backend environment
# Copy this file to /etc/baicai/backend.env on the server, then:
#   chmod 600 /etc/baicai/backend.env
#   chown root:root /etc/baicai/backend.env
# Never commit the real backend.env.

SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:mysql://localhost:3306/blogs?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# Use: openssl rand -base64 48
JWT_SECRET=change-me

# Optional: if both are empty, public registration verification is closed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Public OSS bucket and its public domain.
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=change-me
OSS_ACCESS_KEY_SECRET=change-me
OSS_BUCKET=your-public-bucket
OSS_PUBLIC_URL_PREFIX=https://your-public-bucket.oss-cn-shanghai.aliyuncs.com
OSS_DIR=posts/

# Optional private bucket for internal archive raw snapshots.
# Leave empty to keep snapshots in the database.
OSS_ARCHIVE_BUCKET=
OSS_ARCHIVE_DIR=archive-snapshots/
