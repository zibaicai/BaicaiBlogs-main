# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/

# Java/Maven build artifacts
my-blog-backend/target/
my-blog-backend/.mvn/
my-blog-backend/mvnw
my-blog-backend/mvnw.cmd

# Java IDE
my-blog-backend/.idea/
my-blog-backend/.vscode/
my-blog-backend/*.iml

# 取消追踪 application.yml 文件
application.yml
# 本地/生产密钥配置
application-local.yml
backend.env
!application.yml.example
!deploy/backend.env.example
# monorepo apps
apps/*/node_modules/
apps/*/dist/
apps/web/.next/

# 本地 IDE 配置
/.vscode/

# 本地部署/测试产物
/_deploy/
/_test/
